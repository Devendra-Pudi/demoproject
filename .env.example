# Local Compose defaults. Never commit a real .env or secrets.toml.
# RETRIEVAL_MODE: neural (Ollama models) | demo (labeled curated answers, no models) | smoke (test doubles)
RETRIEVAL_MODE=demo
OLLAMA_MODEL=qwen2.5:1.5b
# Generate a strong shared key before exposing API/dashboard services.
API_KEY=replace-with-a-long-random-secret
# Local speech recognition in project 05. The Docker image already sets this to 1.
ENABLE_LOCAL_STT=1
