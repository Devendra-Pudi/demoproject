FROM python:3.11-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/home/app
WORKDIR /app
COPY pyproject.toml ./
COPY src/ src/
# Neural models are optional: --build-arg INSTALL_NEURAL=true downloads dependencies, not weights.
ARG INSTALL_NEURAL=false
RUN if [ "$INSTALL_NEURAL" = "true" ]; then pip install --no-cache-dir '.[retrieval]'; else pip install --no-cache-dir .; fi
RUN useradd --create-home --uid 1000 app && mkdir -p /app/artifacts && chown app:app /app/artifacts
COPY --chown=app:app data/ data/
COPY --chown=app:app web/ web/
# Editable installation preserves the repo-relative document and web paths used by the service.
RUN pip install --no-deps -e .
USER app
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health')"
CMD ["uvicorn", "ai_portfolio.api:app", "--host", "0.0.0.0", "--port", "8000"]
